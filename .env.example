# ==============================================================================
# SecureCloud - Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your project credentials.
# NEVER COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- Supabase Authentication & Database ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# Database Connection String
# For Supabase PostgreSQL (Transaction Pooler port 6543 or Direct port 5432):
# Example: postgresql://postgres.projectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
# Leave empty to fallback to local SQLite (securecloud.db) for offline development:
DATABASE_URL=

# --- S3-Compatible Object Storage ---
# Compatible with AWS S3, Cloudflare R2, Supabase Storage S3 layer, MinIO, or Backblaze B2.
# Leave S3_ACCESS_KEY empty to use local filesystem storage (storage/uploads/) for offline dev.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=securecloud-storage
S3_REGION=auto

# --- Real ClamAV Antivirus Daemon (Optional) ---
# ClamAV daemon host and port (default 3310).
# If offline/unreachable, the scanner will fail gracefully and report:
# "Signature scanner unavailable; static/ML analysis continued."
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Server & CORS Configuration ---
PORT=8000
CORS_ORIGINS=https://securecloud-app-production.up.railway.app,http://localhost:5173

# --- Frontend Build Configuration (Vite) ---
VITE_API_URL=https://securecloud-app-production.up.railway.app
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
